# Optional ListenBrainz token
LISTENBRAINZ_TOKEN=

# Optional Subsonic/Navidrome connection
SUBSONIC_BASE_URL=
SUBSONIC_USERNAME=
SUBSONIC_PASSWORD=

# Station / queue behavior
HELIX_PREFETCH_AHEAD=3
HELIX_LOBBY_YT_LINK_MAX_ITEMS=100

# Public-safe defaults
HELIX_ENABLE_API_DOCS=false
HELIX_ALLOW_NON_ADMIN_IMPORT=false

# Session cookie security
# Keep this true when Helix is served over HTTPS.
# Set it to false when accessing Helix directly over plain HTTP
# (for example, http://192.168.1.50:8000), otherwise the browser
# will not send the Secure session cookie and you will appear to
# be logged out immediately after signing in.
HELIX_COOKIE_SECURE=true

# Optional OpenID Connect / Authentik login
HELIX_OIDC_ENABLED=false
HELIX_OIDC_DISPLAY_NAME=Authentik
# For Authentik's default per-provider issuer mode this normally looks like:
# https://auth.example.com/application/o/helix
HELIX_OIDC_ISSUER=
HELIX_OIDC_CLIENT_ID=
HELIX_OIDC_CLIENT_SECRET=
# Must exactly match a Redirect URI configured on the Authentik provider.
# Example: https://helix.example.com/auth/oidc/callback
HELIX_OIDC_REDIRECT_URI=
HELIX_OIDC_SCOPES=openid profile email
HELIX_OIDC_USERNAME_CLAIM=preferred_username
HELIX_OIDC_GROUPS_CLAIM=groups
# New Authentik identities create Helix accounts on first successful login.
HELIX_OIDC_AUTO_CREATE_USERS=true
# Safer default: create the initial Helix admin locally before OIDC auto-provisioning.
# Set true only if the first successful OIDC user should be allowed to become admin.
HELIX_OIDC_ALLOW_FIRST_USER_ADMIN=false
# Existing local usernames are NOT linked automatically unless explicitly enabled.
HELIX_OIDC_AUTO_LINK_BY_USERNAME=false
# Optional Authentik group whose newly provisioned users should be Helix admins.
HELIX_OIDC_ADMIN_GROUP=
# When true and HELIX_OIDC_ADMIN_GROUP is set, refresh admin/user role on each OIDC login.
HELIX_OIDC_SYNC_ROLES=false


# Optional random Unsplash login backgrounds
# Create an Unsplash developer application and put its Access Key here.
# The key is only used by the Helix backend and is never sent to the browser.
HELIX_LOGIN_BACKGROUND_UNSPLASH_ENABLED=false
HELIX_UNSPLASH_ACCESS_KEY=
HELIX_LOGIN_BACKGROUND_UNSPLASH_QUERY=vinyl record player turntable music
# Search results are cached server-side so page loads do not consume one API call each.
HELIX_LOGIN_BACKGROUND_UNSPLASH_CACHE_SECONDS=900

# Custom station providers
HELIX_ENABLE_CUSTOM_STATION_TYPES=false
HELIX_CUSTOM_STATION_TYPES_DIR=/data/plugins/stations

# Optional DB watchdog tuning
HELIX_DB_WATCHDOG_WARN_S=2
HELIX_DB_WATCHDOG_ERROR_S=10

# yt-dlp freshness
# Enabled by default because YouTube changes can break playback/downloads
# when yt-dlp becomes stale. If the update fails at startup, Helix will
# continue with the bundled yt-dlp version and log a warning.
HELIX_YTDLP_AUTO_UPDATE=true

# Supported values: stable, nightly
HELIX_YTDLP_CHANNEL=stable
